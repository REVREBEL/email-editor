generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Template {
  id                         String    @id @default(uuid())
  orgId                      String
  name                       String
  slug                       String    @unique
  status                     String
  currentDraftVersionId      String?   @unique
  currentPublishedVersionId  String?   @unique
  styleGuideId               String?
  deletedAt                  DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  versions                   Version[]
  currentDraftVersion        Version?  @relation("CurrentDraftVersion", fields: [currentDraftVersionId], references: [id])
  currentPublishedVersion    Version?  @relation("CurrentPublishedVersion", fields: [currentPublishedVersionId], references: [id])
  organization               Organization @relation(fields: [orgId], references: [id])
  designTags                 DesignTag[]
}

model Version {
  id                      String    @id @default(uuid())
  templateId              String
  template                Template  @relation(fields: [templateId], references: [id])
  number                  Int
  status                  String
  design_json             Json
  html_compiled           String?
  renderer_name           String?
  renderer_ver            String?
  inliner_ver             String?
  createdById             String
  createdBy               User      @relation(fields: [createdById], references: [id])
  createdAt               DateTime  @default(now())
  publishedAt             DateTime?
  locked                  Boolean   @default(false)
  TemplateAsDraft         Template? @relation("CurrentDraftVersion")
  TemplateAsPublished     Template? @relation("CurrentPublishedVersion")
}

model User {
  id          String        @id @default(uuid())
  versions    Version[]
  mediaAssets MediaAsset[]
  userBlocks  UserBlock[]
}

model Organization {
  id          String       @id @default(uuid())
  templates   Template[]
  mediaAssets MediaAsset[]
  mergeTags   MergeTag[]
}

model MediaAsset {
  id           String    @id @default(uuid())
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id])
  filename     String
  content_type String
  byte_size    Int
  storage_key  String
  public_url   String?
  checksum     String
  meta         Json?
  createdById  String
  createdBy    User      @relation(fields: [createdById], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@unique([orgId, checksum])
}

model MergeTag {
  id            String    @id @default(uuid())
  orgId         String
  organization  Organization @relation(fields: [orgId], references: [id])
  key           String
  label         String
  default_value String
  system        Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([orgId, key])
}

model DesignTag {
  id         String   @id @default(uuid())
  key        String
  value      String
  templateId String
  template   Template @relation(fields: [templateId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model UserBlock {
  id         String   @id @default(uuid())
  name       String
  category   String
  block_json Json
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
